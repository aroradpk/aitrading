  "formation_bias": {
    "bullish": [
      "falling_wedge",
      "ascending_triangle",
      "bull_flag",
      "double_bottom",
      "inverse_head_shoulders"
    ],
    "bearish": [
      "rising_wedge",
      "descending_triangle",
      "bear_flag",
      "double_top",
      "head_shoulders"
    ]
